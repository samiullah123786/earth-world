      "css": ".ds-tabs{display:flex;padding:8px 16px;background:var(--color-surface,#faf8f2);border-bottom:1px solid var(--color-border,#7d8879)}.ds-tabs button{font:14px/1.5 var(--font-body,'Segoe UI',sans-serif);color:var(--color-foreground,#28362d);flex:1;min-height:44px;padding:8px 4px;border:0;border-radius:0;background:transparent;cursor:pointer;white-space:nowrap;transition:background var(--duration-fast,120ms) ease-out}.ds-tabs button[aria-pressed=true]{color:var(--color-primary,#355c3d);font-weight:700;box-shadow:inset 0 -2px var(--color-primary,#355c3d)}.ds-tabs button:active{background:var(--color-muted,#e6e9dd)}.ds-tabs button:focus-visible{outline:2px solid var(--color-ring,#38633e);outline-offset:2px;}@media(hover:hover){.ds-tabs button:hover{background:var(--color-muted,#e6e9dd)}}@media(prefers-reduced-motion:reduce){.ds-tabs button{transition:none}}"
