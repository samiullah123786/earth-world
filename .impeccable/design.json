      "html": "<label class=\"ds-label\" for=\"ds-tile-x\">Tile X</label><input class=\"ds-field\" id=\"ds-tile-x\" type=\"number\" min=\"0\" max=\"31\" value=\"3\" aria-describedby=\"ds-placement-error\" aria-invalid=\"false\"><p class=\"ds-validation\" id=\"ds-placement-error\" aria-live=\"polite\"></p>",
